// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy Tab E 9.6 WiFi (SM-T560, "gtelwifi")
 *
 * Panel: Novatek NT51017 (BOE), 800x1280 MIPI DSI video mode, native
 * portrait. Touch: Zinitix ZT7554 on I2C. Charger: SMB358.
 */

/dts-v1/;

#include "sc7730.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	/* Touch supply: a GPIO-switched 3.3 V rail, not a PMIC LDO */
	tsp_ldo: regulator-tsp {
		compatible = "regulator-fixed";
		regulator-name = "tsp_ldo";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 156 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;	/* vendor waits 200 ms */
	};
};

/*
 * Zinitix ZT7554 (vendor "zinitix,zt7554_ts"); pinmux for I2C1 and the
 * IRQ pad comes from the bootloader. GPIOs 81/83 only tell the vendor
 * driver which firmware image to flash.
 */
&i2c1 {
	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt554";
		reg = <0x20>;
		interrupt-parent = <&gpio>;
		interrupts = <82 IRQ_TYPE_EDGE_FALLING>;
		vcca-supply = <&tsp_ldo>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <1280>;
	};
};

/ {
	model = "Samsung Galaxy Tab E 9.6 (SM-T560)";
	compatible = "samsung,gtelwifi", "sprd,sc7730";

	/*
	 * Board id the Spreadtrum bootloader matches against dt.img.
	 * The build script generates one copy per hardware revision.
	 */
	sprd,sc-id = <8830 11 0x20000>;

	aliases {
		serial1 = &uart1;
	};

	chosen {
		/* The bootloader rewrites this, the kernel appends its own */
		bootargs = "";
	};

	/* The bootloader patches the real size in */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x60000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		smem@87800000 {
			reg = <0x87800000 0x240000>;
			no-map;
		};

		cp-modem@88000000 {
			reg = <0x88000000 0x1c00000>;
			no-map;
		};

		/* vendor kernel framebuffer, also our fallback scan-out */
		framebuffer@9ea44000 {
			reg = <0x9ea44000 0xbb8000>;
			no-map;
		};

		/*
		 * Kernel log survives a warm reboot here. Lies inside the area
		 * the vendor kernel reserves for ION, so TWRP will not touch it.
		 */
		ramoops@9fc00000 {
			compatible = "ramoops";
			reg = <0x9fc00000 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};
	};

	/* Scan-out buffer left running by the bootloader (lcd_base=9ea44000) */
	framebuffer@9ea44000 {
		compatible = "simple-framebuffer";
		reg = <0x9ea44000 (800 * 1280 * 4)>;
		width = <800>;
		height = <1280>;
		stride = <(800 * 4)>;
		format = "x8r8g8b8";	/* verified on the panel, Test 1b */
	};
};

&usb {
	status = "okay";
};

/*
 * DDR52 with the vendor's delay-line values. The eMMC I/O rail is a fixed
 * 1.8 V (no vqmmc supply in the vendor tree), but the 1.8 V signalling bit
 * of this SDHCI never sticks ("1.8V regulator output did not become
 * stable"), so ask for DDR at the 3.3 V setting directly: same result
 * without the failed switch, and no-1-8-v also keeps HS200 off.
 */
&emmc {
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	no-1-8-v;
	cap-mmc-highspeed;
	mmc-ddr-3_3v;
	max-frequency = <52000000>;
	sprd,write-delay = <0x08>;
	sprd,read-pos-delay = <0x04>;
	sprd,read-neg-delay = <0x04>;
	status = "okay";
};
