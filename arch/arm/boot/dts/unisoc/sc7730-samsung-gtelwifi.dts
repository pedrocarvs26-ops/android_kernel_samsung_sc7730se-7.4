// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy Tab E 9.6 WiFi (SM-T560, "gtelwifi")
 *
 * Panel: Novatek NT51017 (BOE), 800x1280 MIPI DSI video mode, native
 * portrait. Touch: Zinitix ZT7554 on I2C. Charger: SMB358.
 */

/dts-v1/;

#include "sc7730.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/power/summit,smb347-charger.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	/* Touch supply: a GPIO-switched 3.3 V rail, not a PMIC LDO */
	tsp_ldo: regulator-tsp {
		compatible = "regulator-fixed";
		regulator-name = "tsp_ldo";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 156 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;	/* vendor waits 200 ms */
	};

	/*
	 * Bit-banged bus to the SMB358 charger, as in the vendor tree; sboot
	 * drives the same pins and leaves them muxed as GPIO.
	 */
	i2c-chg {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 159 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 160 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * sboot leaves a 4.35 V float, charging on, termination off.
		 * The vendor kernel set 4.32 V; smb347 rewrites only what is
		 * given here (volatile copies, reloaded from NVM at POR).
		 * No temperature properties: those would switch on the
		 * chip's NTC monitor, which the vendor keeps off (0x07 bit 4).
		 */
		charger: charger@6a {
			compatible = "summit,smb358";
			reg = <0x6a>;
			/* without it, "online" stays at its probe-time value */
			interrupts-extended = <&gpio 161 IRQ_TYPE_EDGE_FALLING>;
			summit,enable-usb-charging;
			summit,enable-charge-control = <SMB3XX_CHG_ENABLE_SW>;
			summit,fast-voltage-threshold-microvolt = <2400000>;
			/*
			 * High-current input mode by the MUIC's charger type:
			 * 1.8 A on a wall charger (vendor value), 1.5 A on a
			 * charging host port, 500 mA on a plain one.
			 */
			extcon = <&muic>;
			summit,mains-current-limit-microamp = <1800000>;
			monitored-battery = <&battery>;
		};
	};

	/*
	 * Power (PBINT) and Volume Down (EXT_RSTN) are PMIC inputs, not part
	 * of the keypad matrix. Power + Volume Down held for ~7-10 s is a
	 * hardware reset in the PMIC, independent of the kernel. The EIC
	 * debounces in hardware, 50 ms as the bootloader sets it.
	 */
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "gtelwifi";
		simple-audio-card,widgets = "Speaker", "Speaker";
		simple-audio-card,routing = "Speaker", "SPK";

		simple-audio-card,cpu {
			sound-dai = <&vbc>;
		};

		simple-audio-card,plat {
			sound-dai = <&audio_pcm>;
		};

		simple-audio-card,codec {
			sound-dai = <&sc2723_codec>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			gpios = <&pmic_eic 2 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_POWER>;
			debounce-interval = <50>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&pmic_eic 10 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <50>;
		};
	};

	/*
	 * BCM43430 A1: WL_REG_ON is GPIO 230 (high = on, vendor waits 200 ms),
	 * its 32 kHz LPO comes from CLK_AUX0. Host wake (GPIO 148, level high)
	 * is not used yet, interrupts come in-band over SDIO.
	 */
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio 230 GPIO_ACTIVE_LOW>;
		clocks = <&clk_aux0>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
	};

	/*
	 * SC2723 fuel gauge (mach-sprd/sc2723-fgu.c). Sense resistor: 20 mOhm
	 * nominal, 20.2 mOhm on this board (vendor rsense_real = 202).
	 */
	fuel-gauge {
		compatible = "sprd,sc2723-fgu-polled";
		monitored-battery = <&battery>;
		power-supplies = <&charger>;
		sprd,calib-resistance-micro-ohms = <20200>;
		/* battery thermistor, vendor sec-battery table (ADC -> 0.1 C) */
		io-channels = <&pmic_adc 1>;
		io-channel-names = "bat-temp";
		sprd,bat-temp-table = <653 700>, <889 600>, <963 580>,
			<1093 530>, <1177 500>, <1307 460>, <1334 450>,
			<1549 400>, <1940 300>, <2392 200>, <2727 100>,
			<2900 50>, <3040 0>, <3210 (-50)>, <3360 (-100)>,
			<3537 (-200)>;
		/* vendor limits: stop charging at -5 / 58 C, resume at 0 / 53 C */
		sprd,charge-stop-celsius = <(-5) 58>;
		sprd,charge-resume-celsius = <0 53>;
	};

	/*
	 * Bit-banged bus to the SM5504 MUIC, which tells USB host ports
	 * (SDP/CDP) from wall chargers (DCP) for the charger's input limit.
	 * The bootloader leaves it in automatic switching, the USB data
	 * path does not depend on the driver.
	 */
	i2c-muic {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 150 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 151 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;
		#address-cells = <1>;
		#size-cells = <0>;

		muic: extcon@14 {
			compatible = "siliconmitus,sm5504-muic";
			reg = <0x14>;
			interrupt-parent = <&gpio>;
			interrupts = <149 IRQ_TYPE_EDGE_FALLING>;
		};
	};

	/* 5000 mAh, data from the vendor sec-fuelgauge/sec-battery nodes */
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <5000000>;
		constant-charge-voltage-max-microvolt = <4320000>;
		constant-charge-current-max-microamp = <2000000>;
		precharge-current-microamp = <450000>;
		charge-term-current-microamp = <200000>;
		factory-internal-resistance-micro-ohms = <220000>;
		voltage-min-design-microvolt = <3400000>;
		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 = <4320000 100>, <4262000 95>, <4205000 90>,
			<4152000 85>, <4101000 80>, <4055000 75>, <4006000 70>,
			<3968000 65>, <3923000 60>, <3880000 55>, <3849000 50>,
			<3824000 45>, <3806000 40>, <3790000 35>, <3778000 30>,
			<3770000 25>, <3761000 20>, <3744000 15>, <3711000 10>,
			<3690000 5>, <3400000 0>;
	};
};

/*
 * Zinitix ZT7554 (vendor "zinitix,zt7554_ts"); pinmux for I2C1 and the
 * IRQ pad comes from the bootloader. GPIOs 81/83 only tell the vendor
 * driver which firmware image to flash. The two capacitive keys next to
 * Home are touch controller icons 0 and 1 (vendor: KEY_RECENT, KEY_BACK).
 */
&i2c1 {
	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt554";
		reg = <0x20>;
		interrupt-parent = <&gpio>;
		interrupts = <82 IRQ_TYPE_EDGE_FALLING>;
		vcca-supply = <&tsp_ldo>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <1280>;
		linux,keycodes = <KEY_APPSELECT KEY_BACK>;
	};
};

/ {
	model = "Samsung Galaxy Tab E 9.6 (SM-T560)";
	compatible = "samsung,gtelwifi", "sprd,sc7730";

	/*
	 * Board id the Spreadtrum bootloader matches against dt.img.
	 * The build script generates one copy per hardware revision.
	 */
	sprd,sc-id = <8830 11 0x20000>;

	/* fixed host numbers: the eMMC must stay mmcblk0 (init, tabflash) */
	aliases {
		mmc0 = &emmc;
		mmc1 = &sdio1;
		mmc2 = &sdio0;
		serial0 = &uart0;
		serial1 = &uart1;
	};

	chosen {
		/* The bootloader rewrites this, the kernel appends its own */
		bootargs = "";
	};

	/* The bootloader patches the real size in */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x60000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		smem@87800000 {
			reg = <0x87800000 0x240000>;
			no-map;
		};

		cp-modem@88000000 {
			reg = <0x88000000 0x1c00000>;
			no-map;
		};

		/* vendor kernel framebuffer, also our fallback scan-out */
		framebuffer@9ea44000 {
			reg = <0x9ea44000 0xbb8000>;
			no-map;
		};

		/*
		 * Kernel log survives a warm reboot here. Lies inside the area
		 * the vendor kernel reserves for ION, so TWRP will not touch it.
		 */
		ramoops@9fc00000 {
			compatible = "ramoops";
			reg = <0x9fc00000 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};

		/*
		 * Scan-out and GPU buffers for DISPC, which has no IOMMU. Kept in
		 * lowmem below the vendor's carve-outs, where all vendor display
		 * buffers lived.
		 */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x4000000>;
			alloc-ranges = <0x90000000 0xe000000>;
			linux,cma-default;
		};
	};

	/* Scan-out buffer left running by the bootloader (lcd_base=9ea44000) */
	framebuffer@9ea44000 {
		compatible = "simple-framebuffer";
		reg = <0x9ea44000 (800 * 1280 * 4)>;
		width = <800>;
		height = <1280>;
		stride = <(800 * 4)>;
		format = "x8r8g8b8";	/* verified on the panel, Test 1b */
		backlight = <&backlight>;
	};

	/*
	 * PWM3 into the RT8555 LED driver (i2c-gpio 65/66 @ 0x31, EN GPIO
	 * 155), which the bootloader sets up and leaves enabled; brightness
	 * 0 is the vendor's off state. 20.4 kHz like the vendor, duty 143
	 * as the bootloader leaves it.
	 */
	/* SC2723 LDO_SDCORE: microSD VDD and the SD0 pads (3 V mode only) */
	vddsdcore: regulator-vddsdcore {
		compatible = "sprd,sc2723-ldo";
		regulator-name = "vddsdcore";
		sprd,pd-reg = <0x814 10>;
		sprd,vsel-reg = <0x830 0xff00>;
		/* min = max: the core sets 3.0 V at registration */
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
	};

	/* SC2723 camera LDOs: analog 2.8 V and I/O 1.8 V for both sensors */
	vddcama: regulator-vddcama {
		compatible = "sprd,sc2723-ldo";
		regulator-name = "vddcama";
		sprd,pd-reg = <0x814 4>;
		sprd,vsel-reg = <0x830 0xff>;
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	vddcamio: regulator-vddcamio {
		compatible = "sprd,sc2723-ldo";
		regulator-name = "vddcamio";
		sprd,pd-reg = <0x814 6>;
		sprd,vsel-reg = <0x81c 0x7f00>;
		sprd,min-microvolt = <1150000>;
		sprd,step-microvolt = <6250>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 3 49039>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <143>;
	};
};

/*
 * Home and Volume Up: KEYOUT0 with KEYIN1/KEYIN2, the only keypad pads the
 * bootloader muxes to the keypad. The vendor tree also lists Volume Down
 * at row 1/column 0, but never scans column 0.
 */
&pwm {
	status = "okay";
};

/*
 * Camera sensors: rear S5K4ECGX @ 0x56 (no driver yet), front SR200PC20M
 * @ 0x20 on D-PHY C. The front does not need the external 1.2 V DVDD
 * (GPIO 193) the vendor pulses.
 */
&i2c0 {
	status = "okay";

	camera@20 {
		compatible = "siliconfile,sr200pc20m";
		reg = <0x20>;
		clocks = <&dcam>;
		avdd-supply = <&vddcama>;
		dovdd-supply = <&vddcamio>;
		reset-gpios = <&gpio 238 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&gpio 187 GPIO_ACTIVE_LOW>;
		orientation = <0>;

		port {
			front_camera_out: endpoint {
				remote-endpoint = <&dcam_front_in>;
				data-lanes = <1>;
			};
		};
	};
};

&dcam {
	status = "okay";
};

&dcam_phy_c {
	dcam_front_in: endpoint {
		remote-endpoint = <&front_camera_out>;
		data-lanes = <1>;
	};
};

/*
 * Accelerometer, ST LIS2HH12 (Samsung calls it K2HH): X = Y_chip,
 * Y = -X_chip, Z = -Z_chip, found by turning the tablet under
 * iio-sensor-proxy. The vendor's axis map (X = -Y_chip, Y = X_chip) is
 * this turned by 180 degrees, and X = -Y_chip, Y = -X_chip got only
 * portrait right. The data-ready line (GPIO 164) is left out, user space
 * polls.
 */
&i2c2 {
	status = "okay";

	accelerometer@1d {
		compatible = "st,lis2hh12";
		reg = <0x1d>;
		mount-matrix = "0", "1", "0",
			       "-1", "0", "0",
			       "0", "0", "-1";
	};
};

&sdio0 {
	bus-width = <4>;
	cd-gpios = <&gpio 71 GPIO_ACTIVE_LOW>;	/* external pull-up */
	cd-debounce-delay-ms = <200>;
	disable-wp;
	cap-sd-highspeed;
	max-frequency = <50000000>;		/* 384 MHz / 8 = 48 MHz */
	no-1-8-v;				/* card VDD is the pad supply */
	sdhci-caps-mask = <0x0 0x05000000>;	/* vendor: 3.0 V only */
	vmmc-supply = <&vddsdcore>;
	status = "okay";
};

/*
 * BCM43430A1 Bluetooth. Wake lines (BT_WAKE GPIO 45, HOST_WAKE GPIO 46)
 * come later: without a host wake IRQ hci_bcm never lets the chip sleep.
 */
&uart0 {
	status = "okay";

	/*
	 * BT_WAKE on GPIO 45, HOST_WAKE on GPIO 46 (vendor bcm-bt-lpm). hci_bcm
	 * tells the controller BT_WAKE is active high and derives HOST_WAKE's
	 * polarity from the interrupt type; the vendor ran both active low.
	 */
	bluetooth {
		compatible = "brcm,bcm43430a1-bt";
		shutdown-gpios = <&gpio 47 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio 45 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpio 46 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "host-wakeup";
		clocks = <&clk_aux0>;
		clock-names = "lpo";
		max-speed = <2000000>;
	};
};

&gpu {
	status = "okay";
};

/*
 * Mono internal speaker on the SC2723's AOL output and internal PA, fed
 * by the VBC through the AP DMA. Headphones and capture to come.
 */
&ap_dma {
	status = "okay";
};

&vbc {
	status = "okay";
};

&audio_pcm {
	status = "okay";
};

&sc2723_codec {
	status = "okay";
};

/*
 * Takes over the DSI video-mode pipeline the bootloader leaves running and
 * sends simpledrm away; the backlight follows the CRTC as with simpledrm.
 * Panel size from the vendor device tree.
 */
&dispc {
	backlight = <&backlight>;
	width-mm = <129>;
	height-mm = <206>;
	status = "okay";
};

&keypad {
	keypad,num-rows = <1>;
	keypad,num-columns = <3>;
	linux,keymap = <MATRIX_KEY(0, 1, KEY_HOMEPAGE)
			MATRIX_KEY(0, 2, KEY_VOLUMEUP)>;
	/* Home wakes the tablet like on Android; Volume Up comes along */
	wakeup-source;
	status = "okay";
};

&usb {
	status = "okay";
};

&sdio1 {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	no-1-8-v;		/* the 1.8 V switch fails like on the eMMC host */
	no-sd;
	no-mmc;
	non-removable;
	keep-power-in-suspend;
	mmc-pwrseq = <&wifi_pwrseq>;
	status = "okay";

	/* out-of-band host wake on GPIO 148, level high as in the vendor tree */
	wifi@1 {
		compatible = "brcm,bcm43430a1-fmac", "brcm,bcm4329-fmac";
		reg = <1>;
		interrupts-extended = <&gpio 148 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
	};
};

/*
 * DDR52 with the vendor's delay-line values. The eMMC I/O rail is a fixed
 * 1.8 V (no vqmmc supply in the vendor tree), but the 1.8 V signalling bit
 * of this SDHCI never sticks ("1.8V regulator output did not become
 * stable"), so ask for DDR at the 3.3 V setting directly: same result
 * without the failed switch, and no-1-8-v also keeps HS200 off.
 */
&emmc {
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	no-1-8-v;
	cap-mmc-highspeed;
	mmc-ddr-3_3v;
	max-frequency = <52000000>;
	sprd,write-delay = <0x08>;
	sprd,read-pos-delay = <0x04>;
	sprd,read-neg-delay = <0x04>;
	status = "okay";
};
